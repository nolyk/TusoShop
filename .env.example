# Set actual values in Railway Variables, never commit secrets.
BOT_TOKEN=
BOT_ADMINS=
# Railway Variables: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Optional if Railway has generated RAILWAY_PUBLIC_DOMAIN.
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
DIGITAL_SHOP_ENABLED=true
DIGITAL_STARS_ENABLED=true
DIGITAL_PREMIUM_ENABLED=true
DIGITAL_GIFTS_ENABLED=false
# Optional integrations (required for Stars/Premium quotes).
MARKETAPP_API_TOKEN=
TONAPI_KEY=
BOT_LOGS_CHANNEL=0
JWT_SECRET=
# Keep the same encryption key across redeployments if a wallet is saved.
WALLET_ENCRYPTION_KEY=
